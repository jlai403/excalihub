# Env contract for ExcaliHub. Varlock resolves values for local runs:
#   bun run test:e2e:local
# CI injects the same variables via the workflow env (secrets.E2E_GIT_TOKEN).

# Fine-grained GitHub PAT scoped to the e2e repo (jlai403/excalihub-ci).
# Used by the git e2e spec to register/reset/verify against the repo.
# Resolved locally via `op read` (1Password desktop app integration).
# @sensitive @required @type=string
E2E_GIT_TOKEN=exec('op read "op://vault/item/field"')

# @type=string
E2E_GIT_REPO=jlai403/excalihub-ci

# Stable e2e SSH private key (matches the persistent excalihub-e2e deploy
# key on jlai403/excalihub-ci). Used by globalSetup to seed the app's
# git-config so the deploy key is reused (never re-registered) across runs.
# CI injects it from secrets.E2E_SSH_PRIVATE_KEY. Resolved locally via 1Password.
# @sensitive @required @type=string
E2E_SSH_PRIVATE_KEY=exec('op read "op://vault/item/field"')
