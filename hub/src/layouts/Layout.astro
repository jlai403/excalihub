---
import '../styles/globals.css';
import Sidebar from '../components/Sidebar.svelte';

const hubHost = `${import.meta.env.HUB_SUBDOMAIN || 'excalihub'}.${import.meta.env.BASE_DOMAIN || 'localhost'}`;

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-hub-host={hubHost}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | ExcaliHub</title>
    <script is:inline>
      window.__hubHost = document.documentElement.dataset.hubHost;
      (() => {
        const t = localStorage.getItem("theme") || "system";
        const dark =
          t === "dark" ||
          (t === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <div class="flex h-screen overflow-hidden">
      <Sidebar client:only="svelte" currentPath={currentPath} />
      <main class="flex-1 overflow-auto p-6">
        <slot />
      </main>
    </div>
  </body>
</html>
