---
import '../styles/globals.css';
import ThemeToggle from '../components/ThemeToggle.svelte';

const hubHost = `${import.meta.env.HUB_SUBDOMAIN || 'excalihub'}.${import.meta.env.BASE_DOMAIN || 'localhost'}`;

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-hub-host={hubHost}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | ExcaliHub</title>
    <script is:inline>
      window.__hubHost = document.documentElement.dataset.hubHost;
      (() => {
        const t = localStorage.getItem("theme") || "system";
        const dark =
          t === "dark" ||
          (t === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <div class="mx-auto max-w-5xl px-4 py-6">
      <header class="mb-8 border-b border-border pb-4">
        <nav class="flex items-center gap-6">
          <a href="/" class="text-lg font-semibold text-foreground hover:text-muted-foreground transition-colors">
            ExcaliHub
          </a>
          <a
            href="/"
            class:list={[
              "text-sm text-muted-foreground hover:text-foreground transition-colors",
              currentPath === "/" && "text-foreground font-medium"
            ]}
          >
            Spaces
          </a>
          <a
            href="/archived"
            class:list={[
              "text-sm text-muted-foreground hover:text-foreground transition-colors",
              currentPath === "/archived" && "text-foreground font-medium"
            ]}
          >
            Archived
          </a>
          <div class="ml-auto">
            <ThemeToggle client:only="svelte" />
          </div>
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
