{
  "name": "excalihub",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": ["server", "hub"],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"bun run dev:server\" \"bun run dev:hub\" \"bun run dev:excalidraw\"",
    "dev:server": "bun --watch server/src/index.ts",
    "dev:hub": "bun run --filter hub dev -- --force",
    "dev:excalidraw": "docker run --rm -p 8080:80 excalidraw/excalidraw:latest",
    "build": "bun run --filter hub build && bun build server/src/index.ts --outdir dist --target bun",
    "test": "bun test server/tests/",
    "test:watch": "bun test server/tests/ --watch",
    "test:e2e": "bun playwright test",
    "test:e2e:local": "varlock run -- bun playwright test",
    "test:e2e:docker": "bun run build && bun playwright test --config playwright.docker.config.ts",
    "test:e2e:ui": "bun playwright test --ui",
    "test:e2e:debug": "bun playwright test --debug",
    "test:report": "bun playwright show-report",
    "demo": "bun playwright test --config tests/e2e/demo.config.ts",
    "demo:gif": "bun run demo && bash scripts/build-demo-gif.sh",
    "typecheck": "bun run typecheck:server && bun run typecheck:hub",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "typecheck:hub": "bun run --filter hub check"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^20.14.0",
    "concurrently": "^10.0.3",
"typescript": "^7.0.2",
    "varlock": "^1.16.0"
  }
}
