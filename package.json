{
  "name": "excalihub",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "concurrently \"bun --watch packages/server/src/index.ts\" \"bun run --filter dashboard dev\"",
    "dev:server": "bun --watch packages/server/src/index.ts",
    "dev:dashboard": "bun run --filter dashboard dev",
    "build": "bun run --filter dashboard build && bun build packages/server/src/index.ts --outdir dist --target bun",
    "start": "bun run dist/server/index.js",
    "test": "bun test packages/server/tests/",
    "test:watch": "bun test packages/server/tests/ --watch"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "concurrently": "^10.0.3",
    "typescript": "^6.0.0"
  }
}
